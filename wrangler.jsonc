{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "daoheal",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "daoheal"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daoheal-community",
      "database_id": "5b28d564-308b-47b6-afd7-7b3f69e464fb",
      "migrations_dir": "database"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://daoheal.pages.dev"
  },
  "observability": {
    "enabled": true
  }
}
